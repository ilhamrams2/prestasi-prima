# ============================================
# EMAIL CONFIGURATION FOR CONTACT NOTIFICATIONS
# ============================================

# Email admin yang akan menerima notifikasi pesan baru
ADMIN_EMAIL=admin@prestasiprima.sch.id

# Konfigurasi SMTP (contoh menggunakan Gmail)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@prestasiprima.sch.id
MAIL_FROM_NAME="SMK Prestasi Prima"

# Alternatif: Menggunakan Mailtrap untuk testing
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your-mailtrap-username
# MAIL_PASSWORD=your-mailtrap-password
# MAIL_ENCRYPTION=tls

# Alternatif: Menggunakan SendGrid
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_ENCRYPTION=tls
